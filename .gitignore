# ============================================================
# 敏感文件（绝不能上传）
# ============================================================
# 代码签名私钥 —— 泄露等于证书作废
*.pfx
*.p12
*.key
*.snk
*.pem

# ============================================================
# 编译产物 / 构建输出
# ============================================================
build/

# 全部历史安装包（237MB）
dist/

# packaging 里的旧版预编译 exe（历史残留，实际由 build_exe.ps1 生成到 build/）
packaging/*.exe

# ============================================================
# 第三方工具链
# ------------------------------------------------------------
# 保留两个完整的构建工具包（构建 shell 扩展 / MSIX 必需）：
#   tools/zig010.whl   (~71MB, zig 编译器)
#   tools/sdktools.zip (~21MB, mt/makeappx/signtool)
# 两者均在 GitHub 单文件 100MB 限制内，clone 后解压即可构建。
# ============================================================
# zig 编译器解压目录（317MB，可从 zig010.whl 重建）
tools/zigpkg/
# Windows SDK 工具解压目录（54MB，可从 sdktools.zip 重建）
tools/sdktools/
# zig 备选路径
tools/zig/
# 工具临时输出
tools/build/

# 下载不完整/损坏的残留包（勿传）
tools/zig.whl
tools/zig.zip

# ============================================================
# 编译出的诊断 exe（源码 .cs/.c 保留，产物不传）
# ============================================================
tools/*.exe

# ============================================================
# 备份 / 临时 / 环境文件
# ============================================================
*.bak
*.bak-*
*.tmp
*.part
*.pyc
__pycache__/
# 环境占位文件
.workbuddy_x
*.log
regmenu_out.txt

# ============================================================
# IDE / 系统
# ============================================================
.vs/
.vscode/
*.suo
*.user
Thumbs.db
desktop.ini
.DS_Store
